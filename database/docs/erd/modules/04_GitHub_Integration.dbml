// Team AI Orchestrator | 04 GitHub Integration
// Generated from actual PostgreSQL schema export, 2026-11-15.
// 2 tables, 1 internal FK constraints, 4 external FK constraints.
// Module view shows only internal FK lines, to keep diagram readable.
// All external FK relationships are preserved in the complete full-schema.dbml.
// DBML does not fully encode CHECK, trigger, RLS, and PostgreSQL-specific index expressions.

Project Team_AI_04_GitHub_Integration {
  database_type: 'PostgreSQL'
}

Table github_connections {
  id uuid [pk, not null]
  project_id uuid [not null, unique]
  connected_by uuid [not null]
  installation_id bigint [not null]
  repository_id bigint [not null]
  repository_owner varchar(100) [not null]
  repository_name varchar(100) [not null]
  status varchar(20) [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, id) [unique]
  }
}

Table github_issues {
  id uuid [pk, not null]
  project_id uuid [not null]
  connection_id uuid [not null]
  backlog_id uuid [not null]
  task_id uuid [not null]
  github_issue_id bigint
  github_issue_number integer
  github_issue_url text
  sync_status varchar(20) [not null, default: 'pending']
  last_error text
  last_synced_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (connection_id, task_id) [unique]
  }
}

Ref: github_issues.(project_id, connection_id) > github_connections.(project_id, id) // fk_github_issue_connection_same_project

// External foreign keys (visible on full diagram):
// github_connections.(project_id) -> projects.(id) [fk_github_connection_project]
// github_connections.(connected_by) -> users.(id) [fk_github_connection_user]
// github_issues.(project_id, backlog_id) -> backlogs.(project_id, id) [fk_github_issue_backlog_same_project]
// github_issues.(backlog_id, task_id) -> tasks.(backlog_id, id) [fk_github_issue_task_same_backlog]
