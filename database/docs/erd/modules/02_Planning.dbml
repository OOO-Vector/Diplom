// Team AI Orchestrator | 02 Planning
// Generated from actual PostgreSQL schema export, 2026-11-15.
// 4 tables, 5 internal FK constraints, 2 external FK constraints.
// Module view shows only internal FK lines, to keep diagram readable.
// All external FK relationships are preserved in the complete full-schema.dbml.
// DBML does not fully encode CHECK, trigger, RLS, and PostgreSQL-specific index expressions.

Project Team_AI_02_Planning {
  database_type: 'PostgreSQL'
}

Table specifications {
  id uuid [pk, not null]
  project_id uuid [not null]
  uploaded_by uuid [not null]
  version integer [not null]
  title varchar(200) [not null]
  original_filename varchar(255)
  content text [not null]
  status varchar(20) [not null, default: 'uploaded']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, id) [unique]
    (project_id, version) [unique]
  }
}

Table backlogs {
  id uuid [pk, not null]
  project_id uuid [not null]
  specification_id uuid [not null]
  version integer [not null]
  status varchar(20) [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  approved_at timestamptz

  indexes {
    (specification_id, version) [unique]
    (project_id, id) [unique]
  }
}

Table tasks {
  id uuid [pk, not null]
  backlog_id uuid [not null]
  parent_task_id uuid
  task_type varchar(12) [not null]
  title varchar(250) [not null]
  description text
  acceptance_criteria text
  status varchar(20) [not null, default: 'draft']
  priority smallint [not null, default: 3]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (backlog_id, id) [unique]
  }
}

Table task_dependencies {
  backlog_id uuid [not null]
  blocking_task_id uuid [not null]
  blocked_task_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (backlog_id, blocking_task_id, blocked_task_id) [pk]
  }
}

Ref: backlogs.(project_id, specification_id) > specifications.(project_id, id) // fk_backlog_spec_project
Ref: task_dependencies.(backlog_id, blocked_task_id) > tasks.(backlog_id, id) [delete: cascade] // fk_dep_blocked_same_backlog
Ref: task_dependencies.(backlog_id, blocking_task_id) > tasks.(backlog_id, id) [delete: cascade] // fk_dep_blocking_same_backlog
Ref: tasks.backlog_id > backlogs.id // fk_task_backlog
Ref: tasks.(backlog_id, parent_task_id) > tasks.(backlog_id, id) // fk_task_parent_same_backlog

// External foreign keys (visible on full diagram):
// specifications.(project_id) -> projects.(id) [fk_spec_project]
// specifications.(uploaded_by) -> users.(id) [fk_spec_uploader]
